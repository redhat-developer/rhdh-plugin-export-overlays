{
  "schemaVersion": 1,
  "collection": "rhdh-plugin-export-overlays",
  "selectors": [
    {
      "prefix": "global/",
      "destination": {
        "kind": "environment",
        "stripPrefix": "global/",
        "requirePrefix": "VAULT_",
        "keyTransform": "legacy-env"
      }
    },
    {
      "prefix": "workspaces/${workspace}/",
      "optional": true,
      "destination": {
        "kind": "environment",
        "stripPrefix": "workspaces/${workspace}/",
        "requirePrefix": "VAULT_",
        "keyTransform": "legacy-env"
      }
    }
  ]
}

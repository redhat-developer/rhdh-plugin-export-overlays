# Generated by run-e2e.sh (root-level files)
/package.json
/playwright.config.ts
/playwright.list.config.ts
/dynamic-plugins.default.yaml

# Dependencies
node_modules/
package-lock.json
pnpm-lock.yaml

# https://yarnpkg.com/getting-started/qa#which-files-should-be-gitignored
.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions

# Playwright Test Results
e2e/test-results/
e2e/playwright-report/
e2e/**/screenshots/

# Playwright state
.auth/
playwright/.cache/

# Test videos and traces
test-results/
e2e-test-report
playwright-report/
*.webm
*.zip

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build outputs
build/
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# Python Caches
**/__pycache__/
**/.pytest_cache/
**/.venv/

